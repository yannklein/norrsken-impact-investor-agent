          "assignments": [
            {
              "id": "m1",
              "name": "investor_name",
              "value": "={{ $json.output.investor_name }}",
              "type": "string"
            },
            {
              "id": "m2",
              "name": "website",
              "value": "={{ $(\"Investor Form\").first().json.website }}",
              "type": "string"
            },
            {
              "id": "m3",
