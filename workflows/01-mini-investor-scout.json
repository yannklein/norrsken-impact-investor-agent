              "value": "={{ $json.output.key_partner }}",
              "type": "string"
            },
            {
              "id": "m6",
              "name": "linkedin_search_url",
              "value": "={{ ($json.output.key_partner && !$json.output.key_partner.toLowerCase().startsWith(\"not found\")) ? \"https://www.linkedin.com/search/results/people/?keywords=\" + encodeURIComponent($json.output.key_partner.split(\",\")[0] + \" \" + $json.output.investor_name) : \"https://www.linkedin.com/search/results/people/?keywords=\" + encodeURIComponent($json.output.investor_name + \" partner\") }}",
              "type": "string"
            },
            {
              "id": "m7",
              "name": "email_subject",
              "value": "={{ $json.output.email_subject }}",
              "type": "string"
            },
            {
              "id": "m8",
