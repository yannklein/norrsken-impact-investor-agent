{
  "name": "Workshop: Impact Investor Research Agent",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Impact Investor Research Agent",
        "formDescription": "Describe your startup and its impact. The agent will research every investor in your list, score each one on impact alignment and business fit, and prepare outreach drafts for the strongest matches. The form is pre-filled with a fictional sample startup (Sobrante): keep it or replace it with your own.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Startup name",
              "fieldName": "startup_name",
              "defaultValue": "Sobrante",
              "requiredField": true
            },
            {
              "fieldLabel": "Founder name (used to sign the emails)",
              "fieldName": "founder_name",
              "defaultValue": "Laia Puig",
              "requiredField": true
            },
            {
              "fieldLabel": "One-liner",
              "fieldName": "one_liner",
              "defaultValue": "We turn unsold food from Barcelona's restaurants and markets into safe, protein-rich animal feed.",
              "requiredField": true
            },
            {
              "fieldLabel": "Problem addressed and who benefits",
              "fieldName": "problem_beneficiaries",
              "defaultValue": "Restaurants and municipal markets in Barcelona throw away tonnes of edible surplus every week. It ends up in landfill, where it emits methane. Meanwhile, local livestock farmers depend on imported soy-based feed linked to deforestation. We collect surplus daily, process it into certified feed and sell it to farms within 150 km. Beneficiaries: local farmers (cheaper, local feed), food businesses (lower waste fees), and the climate.",
              "requiredField": true,
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "Relevant SDGs (2 or 3 max)",
              "fieldName": "sdgs",
              "defaultValue": "SDG 12.3 (halve food waste), SDG 13 (climate action), SDG 15 (life on land)",
              "requiredField": true
            },
            {
              "fieldLabel": "Core impact KPIs (with numbers if you have them)",
              "fieldName": "impact_kpis",
              "defaultValue": "Tonnes of food waste diverted from landfill (2026 pilot: 420 t); tonnes of CO2e avoided; tonnes of imported soy feed replaced",
              "requiredField": true,
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "Business model and traction",
              "fieldName": "business_model",
              "defaultValue": "B2B: collection fees paid by restaurants and markets + feed sales to farms. 38 restaurants and 3 municipal markets signed, 12 farms buying monthly.",
              "requiredField": true,
              "fieldType": "textarea"
            },
            {
              "fieldLabel": "Stage",
              "fieldType": "dropdown",
              "fieldName": "stage",
              "defaultValue": "Seed",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Pre-seed"
                  },
                  {
                    "option": "Seed"
                  },
                  {
                    "option": "Series A"
                  },
                  {
                    "option": "Series B or later"
                  }
                ]
              },
              "requiredField": true
            },
            {
              "fieldLabel": "Amount you are raising",
              "fieldName": "amount_raising",
              "defaultValue": "EUR 1.5M",
              "requiredField": true
            },
            {
              "fieldLabel": "Geography",
              "fieldName": "geography",
              "defaultValue": "Barcelona, expanding to the rest of Spain and Southern Europe",
              "requiredField": true
            }
          ]
        },
        "options": {
          "buttonLabel": "Find my impact investors",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Your agent is on it! Results will appear in the \"matches\" tab of your Google Sheet in a few minutes, and Gmail drafts will be prepared for the strongest matches (overall score 6.5+)."
            }
          }
        }
      },
